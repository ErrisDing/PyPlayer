{
  "permissions": {
    "allow": [
      "Bash(pip install:*)",
      "Bash(python:*)",
      "Bash(cd:*)",
      "Bash(pip list:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"D:/Codes/GitHub/PyPlayer/.claude/check_var_init.py\"",
            "timeout": 30,
            "statusMessage": "Checking variable initialization patterns"
          },
          {
            "type": "command",
            "command": "python \"D:/Codes/GitHub/PyPlayer/.claude/update_readme.py\" \"D:/Codes/GitHub/PyPlayer\"",
            "timeout": 15,
            "statusMessage": "Updating README.md file structure"
          }
        ]
      }
    ]
  }
}
