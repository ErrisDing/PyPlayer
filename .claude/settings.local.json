{
  "permissions": {
    "allow": [
      "Bash(pip install:*)",
      "Bash(python:*)",
      "Bash(cd:*)",
      "Bash(ls -la \"D:/Codes/Python/PyPlayer\"/*.py)",
      "Bash(dir \"D:\\\\Codes\\\\Python\\\\PyPlayer\\\\*.py\")",
      "Bash(pip search:*)",
      "Bash(pip index:*)",
      "Bash(pip show:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"D:/Codes/Python/PyPlayer/.claude/check_var_init.py\" < /dev/stdin 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Checking variable initialization patterns"
          },
          {
            "type": "command",
            "command": "/usr/bin/python3 \"D:/Codes/Python/PyPlayer/.claude/update_readme.py\" \"D:/Codes/Python/PyPlayer\"",
            "timeout": 15,
            "statusMessage": "Updating README.md file structure"
          }
        ]
      }
    ]
  }
}
